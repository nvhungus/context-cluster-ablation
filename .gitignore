# ---- Downloaded Kaggle session archives ----------------------------------
# The extracted per-run records are committed under release/runs/; the
# downloaded .zip bundles are redundant and large.
kaggle/
*.zip
*.tar
*.tar.gz
*.7z

# ---- Regenerated benchmark output ----------------------------------------
results/benchmark*/
*_profile.txt

# ---- Paper sources and third-party material ------------------------------
# The manuscript, IEEEtran.cls and the conference template are not part of
# this release and are not ours to redistribute.
submission/
fjcai_template_extract/
Report_LaTeX/
docs/
*.pdf
*.cls
*.docx

